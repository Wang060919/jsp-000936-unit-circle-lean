OriginalUnitCircleStatement.original_classification (n : ℕ) (hn : 0 < n) (z : Fin n → ℂ)
  (hunit : ∀ (i : Fin n), ‖z i‖ = 1) (hinj : Function.Injective z) : literalMinimizer z ↔ literalRegular z
OriginalUnitCircleStatement.original_lower_bound (n : ℕ) (hn : 0 < n) (z : Fin n → ℂ) (hunit : ∀ (i : Fin n), ‖z i‖ = 1)
  (hinj : Function.Injective z) : literalMaximum (regularCoordinates n) ≤ literalMaximum z
